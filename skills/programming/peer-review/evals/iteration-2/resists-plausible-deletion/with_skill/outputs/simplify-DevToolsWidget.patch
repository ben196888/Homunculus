+function RadioGroup<T extends string>({
+  name, legend, options, value, onChange,
+}: {
+  name: string;
+  legend: string;
+  options: ReadonlyArray<readonly [T, string]>;
+  value: T;
+  onChange: (next: T) => void;
+}) {
+  return (
+    <fieldset className="dev-tools__group">
