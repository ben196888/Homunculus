diff --git a/packages/webapp/src/app/globals.css b/packages/webapp/src/app/globals.css
index 530be733..e60616cf 100644
--- a/packages/webapp/src/app/globals.css
+++ b/packages/webapp/src/app/globals.css
@@ -457,3 +457,27 @@ body:has(.modal[open]) {
 .menu-item:hover {
   background: var(--paper-2);
 }
+
+/* Developer harness drawer (dev-only route). */
+.dev-tools__launcher {
+  position: fixed; right: 20px; bottom: 20px; z-index: 1301;
+  width: 40px; height: 40px; font-size: 20px; line-height: 1; cursor: pointer;
+  border: 2px solid var(--ink); border-radius: 50%;
+  background: var(--orange); color: var(--ink); box-shadow: 0 3px 0 var(--ink);
+}
+.dev-tools__launcher[data-open='true'] { opacity: 0; pointer-events: none; }
+.dev-tools { box-sizing: border-box; border-bottom: 0; }
+.dev-tools--right { margin: 0 0 0 auto; width: 320px; max-width: 320px; height: 100vh; max-height: 100vh; border-radius: 0; border-right: 0; }
+.dev-tools--bottom { margin: auto 0 0; width: 100%; max-width: 100%; max-height: 80vh; border-radius: 22px 22px 0 0; }
+.dev-tools__header { display: flex; align-items: center; gap: 8px; font-size: 20px; }
+.dev-tools__header h2 { flex: 1; margin: 0; font-size: 20px; font-weight: 800; }
+.dev-tools__header button { width: 36px; height: 36px; border: 0; background: transparent; color: inherit; cursor: pointer; font-size: 28px; line-height: 1; }
+.dev-tools__hint { margin: 6px 0 0; color: #666; font-size: 14px; }
+.dev-tools hr { margin: 16px 0; border: 0; border-top: 1px solid #d8d1c7; }
+.dev-tools__group { margin: 0; padding: 0; border: 0; }
+.dev-tools__group legend { margin-bottom: 8px; font-weight: 700; }
+.dev-tools__group label { display: flex; align-items: center; gap: 10px; min-height: 40px; cursor: pointer; }
+.dev-tools__group input { width: 18px; height: 18px; accent-color: var(--orange); }
+@media (max-width: 767px) {
+  .dev-tools__launcher { right: 12px; top: 72px; bottom: auto; }
+}
