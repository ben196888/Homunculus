+      {options.map(([optionValue, label]) => (
+        <label key={optionValue} data-testid={`${name}-${optionValue}`}>
+          <input
+            type="radio"
+            name={name}
+            value={optionValue}
+            checked={value === optionValue}
+            onChange={() => onChange(optionValue)}
+          />
+          {label}
+        </label>
+      ))}
+    </fieldset>
+  );
+}
 
